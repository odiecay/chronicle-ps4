+fn statement_contexts(process: &SBProcess, c: &Compiler, mut statement: u32)
+    -> Result<HashMap<u32, Vec<config::ControlSelector>>> {
+    let mut statements = Vec::new();
+    let mut visited = HashSet::new();
+    while statement != 0 {
+        ensure!(visited.insert(statement), "cyclic lowered statement list");
+        ensure!(visited.len() <= 8192, "statement list exceeds verified limit");
+        let address = statement as u64;
+        let kind = read(process, address + 4, 1)?[0];
+        let mut record = Statement { address: statement, ..Statement::default() };
+        if kind == 2 {
+            record.label = Some(u32_at(process, address + 14)?);
+        } else if matches!(kind, 6 | 7) {
+            if let Some((value, comparison)) = condition_integer(process, c, u32_at(process, address + 10)?)? {
+                record.conditional = Some(Conditional {
+                    value,
+                    jump_when_equal: (kind == 6) == (comparison == 0x17),
+                    target: u32_at(process, address + 14)?,
+                });
+            }
+        } else if kind == 5 {
+            let descriptor = u32_at(process, address + 14)? as u64;
+            ensure!(descriptor != 0, "null switch descriptor");
+            record.switch_default = Some(u32_at(process, descriptor + 4)?);
+            let mut case = u32_at(process, descriptor)? as u64;
+            let mut cases_seen = HashSet::new();
+            while case != 0 {
+                ensure!(cases_seen.insert(case), "cyclic switch case list");
+                ensure!(cases_seen.len() <= 1024, "switch case list exceeds verified limit");
+                let lower = small_integer(process, case + 8)?;
+                let upper = small_integer(process, case + 24)?;
+                // Every descriptor keeps its target, including unsupported bounds.
+                record.cases.push(SwitchCase {
+                    label: u32_at(process, case + 4)?,
+                    values: control::case_values(lower, upper),
+                });
+                case = u32_at(process, case)? as u64;
+            }
+        }
+        statements.push(record);
+        statement = u32_at(process, address)?;
+    }
+    control::contexts(&statements)
+}
