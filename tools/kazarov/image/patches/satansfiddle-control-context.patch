+    let early_target = format!("{policy}\n[[floating_point.expression_overrides]]\ntranslation_unit='semantic.cpp'\nfunction='placements__Fi'\ncallee='consume__Fffff'\nvalue_type='binary32'\nvalue_bits='0x44000000'\nevaluate_first=true\n");
+    fs::write(&config, compiler_config(&compiler, &early_target)).unwrap();
+    assert_rejected(&input, &work.0.join("early-target.o"), &config, "does not participate in the ordinary walk");
+}
