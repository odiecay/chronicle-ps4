+fn control_argument_and_ordinary_walk_selectors_are_validated() {
+    let scoped = EXPRESSION.replace("function = 'float__Fv'",
+        "function = 'float__Fv'\ncallee = 'placement__Fffff'\nevaluate_before = 1");
+    let policy = format!("{scoped}\n[floating_point.expression_overrides.control]\nkind='condition'\nvalues=[10,7,9]\n[floating_point.expression_overrides.argument]\nargument_index=1\nvalue_type='binary32'\nvalue_bits='0x44000000'\n");
+    let config = parse(&policy).unwrap();
+    let row = &config.floating_point.expression_overrides[0];
+    assert_eq!(row.control.as_ref().unwrap().values, [7,9,10]);
+    assert_eq!(row.argument.as_ref().unwrap().argument_index, 1);
+    assert_eq!(row.evaluate_before, Some(1));
+    let encoded = serde_json::to_string(&config).unwrap();
+    assert_eq!(Config::parse(&encoded).unwrap().floating_point.expression_overrides[0].control,
+        row.control);
+    for (from, to) in [
+        ("callee = 'placement__Fffff'", ""),
+        ("values=[10,7,9]", "values=[]"),
+        ("values=[10,7,9]", "values=[9,9]"),
+        ("kind='condition'", "kind='ordinal'"),
+        ("argument_index=1", "argument_index=16"),
+        ("0x44000000", "0x100000000"),
+        ("evaluate_before = 1", "evaluate_before = 16"),
+        ("evaluate_first = false", "evaluate_first = true"),
+    ] {
+        assert!(parse(&policy.replace(from, to)).is_err(), "accepted {to}");
+    }
+    assert!(parse(&format!("{policy}{policy}")).is_err());
+    let reordered = policy.replace("values=[10,7,9]", "values=[7,9,10]");
+    assert!(parse(&format!("{policy}{reordered}")).is_err());
+    assert!(parse(&policy.replace("kind='condition'", "kind='switch'")).is_ok());
+    let legacy = serde_json::to_string(&parse(EXPRESSION).unwrap()).unwrap();
+    for field in ["control", "argument", "evaluate_before", "expected_matches"] { assert!(!legacy.contains(field)); }
+}
