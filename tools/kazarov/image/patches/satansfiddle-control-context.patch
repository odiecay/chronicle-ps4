+        .map_err(|e| anyhow!("write argument walk head: {e:?}"))?;
+    if std::env::var_os("SATANSFIDDLE_VERIFY").is_some() {
+        ensure!(reg(frame, "esi")? == arguments.first().copied().unwrap_or(0),
+            "argument walk head readback failed");
