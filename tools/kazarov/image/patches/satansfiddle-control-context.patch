--- /dev/null
+++ b/src/control.rs
@@ -0,0 +1,299 @@
+//! Source control identities reconstructed from the verified lowered statement list.
+//! Positions and compiler pointers locate graph regions; neither is a selector.
+use crate::config::{ControlKind, ControlSelector, ExpressionOverride};
+use anyhow::{Result, ensure};
+use std::collections::HashMap;
+
+#[derive(Debug)]
+pub struct Conditional {
+    pub value: i32,
+    pub jump_when_equal: bool,
+    pub target: u32,
+}
+
+#[derive(Debug)]
+pub struct SwitchCase {
+    pub label: u32,
+    pub values: Option<Vec<i32>>,
+}
+
+#[derive(Debug, Default)]
+pub struct Statement {
+    pub address: u32,
+    pub label: Option<u32>,
+    pub conditional: Option<Conditional>,
+    pub cases: Vec<SwitchCase>,
+    pub switch_default: Option<u32>,
+}
+
+pub fn case_values(lower: Option<i32>, upper: Option<i32>) -> Option<Vec<i32>> {
+    let (lower, upper) = (lower?, upper?);
+    if upper < lower || i64::from(upper) - i64::from(lower) >= 16 { return None; }
+    Some((lower..=upper).collect())
+}
+
+pub fn contexts(statements: &[Statement]) -> Result<HashMap<u32, Vec<ControlSelector>>> {
+    let labels: HashMap<_, _> = statements.iter().enumerate()
+        .filter_map(|(index, statement)| statement.label.map(|label| (label, index)))
+        .collect();
+    let mut contexts: HashMap<u32, Vec<ControlSelector>> = HashMap::new();
+    let mut add = |start: usize, end: usize, kind, mut values: Vec<i32>| {
+        values.sort_unstable();
+        values.dedup();
+        for statement in &statements[start..end] {
+            contexts.entry(statement.address).or_default().push(ControlSelector {
+                kind, values: values.clone(),
+            });
+        }
+    };
+    for (index, statement) in statements.iter().enumerate() {
+        if let Some(conditional) = &statement.conditional {
+            // A forward unequal exit bounds the equality-controlled body.
+            // Consecutive equal jumps to its entry label form short-circuit OR.
+            if !conditional.jump_when_equal {
+                if let Some(&end) = labels.get(&conditional.target) {
+                    if end > index + 1 {
+                        let mut values = vec![conditional.value];
+                        if let Some(entry) = statements[index + 1].label {
+                            for prefix in statements[..index].iter().rev() {
+                                let Some(prefix) = &prefix.conditional else { break };
+                                if !prefix.jump_when_equal || prefix.target != entry { break; }
+                                values.push(prefix.value);
+                            }
+                        }
+                        add(index + 1, end, ControlKind::Condition, values);
+                    }
+                }
+            }
+        }
+        if let Some(default) = statement.switch_default {
+            // The default target is a boundary, not a verified switch join.
+            // Accept only layouts with no explicit case after that boundary.
+            let &end = labels.get(&default)
+                .ok_or_else(|| anyhow::anyhow!("switch default label is absent"))?;
+            ensure!(end > index, "switch default is not forward");
+            let mut groups: HashMap<usize, Vec<i32>> = HashMap::new();
+            for case in &statement.cases {
+                let &start = labels.get(&case.label)
+                    .ok_or_else(|| anyhow::anyhow!("switch case label is absent"))?;
+                ensure!(start > index && start <= end,
+                    "unsupported nonterminal switch default or nonforward case");
+                let values = case.values.as_ref()
+                    .ok_or_else(|| anyhow::anyhow!("unsupported switch case integer bounds or range"))?;
+                ensure!(!values.is_empty(), "empty switch case values");
+                groups.entry(start).or_default().extend(values);
+            }
+            let mut groups: Vec<_> = groups.into_iter().collect();
+            groups.sort_unstable_by_key(|group| group.0);
+            for (position, (start, values)) in groups.iter().enumerate() {
+                let stop = groups.get(position + 1).map(|group| group.0).unwrap_or(end);
+                add(*start, stop, ControlKind::Switch, values.clone());
+            }
+        }
+    }
+    Ok(contexts)
+}
+
+pub fn specificity(row: &ExpressionOverride) -> usize {
+    usize::from(row.callee.is_some())
+        + usize::from(row.nested_call.is_some() || row.nested_variable.is_some())
+        + usize::from(row.control.is_some())
+        + usize::from(row.argument.is_some())
+}
+
+/// Resolve all applicable rows before writing any policy or recording consumption.
+pub fn winning_rows(rows: &[ExpressionOverride], applicable: &[usize]) -> Result<Vec<usize>> {
+    let Some(best) = applicable.iter().map(|&index| specificity(&rows[index])).max()
+        else { return Ok(Vec::new()); };
+    let winners: Vec<_> = applicable.iter().copied()
+        .filter(|&index| specificity(&rows[index]) == best).collect();
+    let first = &rows[winners[0]];
+    ensure!(winners.iter().all(|&index| {
+        (rows[index].evaluate_first, rows[index].evaluate_before)
+            == (first.evaluate_first, first.evaluate_before)
+    }), "conflicting expression policies at specificity {best} in {}/{} bits {:#x}",
+        first.translation_unit, first.function, first.value_bits);
+    Ok(winners)
+}
+
+#[derive(Debug)]
+pub struct WalkArgument {
+    pub node: u32,
+    pub category: u16,
+    pub evaluated: bool,
+    pub evaluate_first: bool,
+}
+
+/// Stable topological ordering changes evaluation only; formal slots stay intact.
+pub fn evaluation_order(arguments: &[WalkArgument], priorities: &[(u32, u8)]) -> Result<Vec<u32>> {
+    let mut edges = Vec::new();
+    for &(argument, before) in priorities {
+        let source = arguments.iter().position(|node| node.node == argument)
+            .ok_or_else(|| anyhow::anyhow!("selected argument is absent from call"))?;
+        let target = usize::from(before);
+        ensure!(target < arguments.len(), "evaluate_before argument is absent from call");
+        ensure!(source != target, "argument cannot evaluate before itself");
+        for index in [source, target] {
+            let node = &arguments[index];
+            ensure!(matches!(node.category & 7, 1 | 2) && !node.evaluated && !node.evaluate_first,
+                "evaluate_before argument {index} does not participate in the ordinary walk");
+        }
+        edges.push((source, target));
+    }
+    fn visit(index: usize, arguments: &[WalkArgument], edges: &[(usize, usize)],
+        state: &mut [u8], result: &mut Vec<u32>) -> Result<()> {
+        ensure!(state[index] != 1, "cyclic evaluate_before policies");
+        if state[index] == 2 { return Ok(()); }
+        state[index] = 1;
+        for &(source, target) in edges {
+            if target == index { visit(source, arguments, edges, state, result)?; }
+        }
+        result.push(arguments[index].node);
+        state[index] = 2;
+        Ok(())
+    }
+    let mut state = vec![0; arguments.len()];
+    let mut result = Vec::new();
+    for index in 0..arguments.len() {
+        visit(index, arguments, &edges, &mut state, &mut result)?;
+    }
+    Ok(result)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn equality_regions_and_or_clauses_end_at_the_actual_join() {
+        let branch = |address, value, equal, target| Statement { address,
+            conditional: Some(Conditional { value, jump_when_equal: equal, target }),
+            ..Statement::default() };
+        let statements = vec![branch(1, 7, true, 40), branch(2, 9, true, 40),
+            branch(3, 10, false, 60), Statement { address: 4, label: Some(40), ..Statement::default() },
+            Statement { address: 5, ..Statement::default() },
+            Statement { address: 6, label: Some(60), ..Statement::default() },
+            branch(7, 90, false, 100), Statement { address: 8, ..Statement::default() },
+            Statement { address: 9, label: Some(100), ..Statement::default() }];
+        let result = contexts(&statements).unwrap();
+        assert_eq!(result[&5][0].values, [7, 9, 10]);
+        assert!(!result.contains_key(&6));
+        assert_eq!(result[&8][0].values, [90]);
+        assert!(!result.contains_key(&9));
+    }
+
+    fn switch_fixture() -> Vec<Statement> {
+        vec![Statement { address: 1, cases: vec![
+                SwitchCase { label: 20, values: Some(vec![1]) },
+                SwitchCase { label: 40, values: Some(vec![9, 10]) }],
+            switch_default: Some(60), ..Statement::default() },
+            Statement { address: 2, label: Some(20), ..Statement::default() },
+            Statement { address: 3, ..Statement::default() },
+            Statement { address: 4, label: Some(40), ..Statement::default() },
+            Statement { address: 5, ..Statement::default() },
+            Statement { address: 6, label: Some(60), ..Statement::default() },
+            Statement { address: 7, ..Statement::default() }]
+    }
+
+    #[test]
+    fn grouped_switch_cases_stop_at_the_terminal_default_boundary() {
+        let mut statements = switch_fixture();
+        statements[0].cases.push(SwitchCase { label: 60, values: Some(vec![11]) });
+        let result = contexts(&statements).unwrap();
+        assert_eq!(result[&3][0].values, [1]);
+        assert_eq!(result[&5][0].values, [9, 10]);
+        assert!(!result.contains_key(&6));
+        assert!(!result.contains_key(&7)); // An explicit default body is not the join.
+    }
+
+    #[test]
+    fn unsupported_case_bounds_reject_the_entire_reconstruction() {
+        for bounds in [(Some(100), Some(116)), (None, Some(116)),
+            (Some(100), None), (Some(116), Some(100))] {
+            let mut statements = switch_fixture();
+            statements[0].cases[1].values = case_values(bounds.0, bounds.1);
+            assert!(contexts(&statements).unwrap_err().to_string().contains("integer bounds or range"));
+        }
+        assert_eq!(case_values(Some(-1), Some(1)).unwrap(), [-1, 0, 1]);
+        assert_eq!(case_values(Some(i32::MAX), Some(i32::MAX)).unwrap(), [i32::MAX]);
+    }
+
+    #[test]
+    fn nonterminal_default_and_missing_case_targets_fail_closed() {
+        let mut statements = switch_fixture();
+        statements[0].switch_default = Some(20);
+        assert!(contexts(&statements).unwrap_err().to_string().contains("nonterminal"));
+        statements[0].switch_default = Some(60);
+        statements[0].cases[1].label = 99;
+        assert!(contexts(&statements).is_err());
+        statements[0].switch_default = Some(99);
+        assert!(contexts(&statements).is_err());
+    }
+
+    fn policy_rows() -> Vec<ExpressionOverride> {
+        let value = r#"{"compiler_path":"compiler.exe","floating_point":{"expression_overrides":[
+            {"translation_unit":"test.cpp","function":"f","callee":"call","value_type":"binary32","value_bits":"0x3f000000","control":{"kind":"condition","values":[11]},"evaluate_first":true},
+            {"translation_unit":"test.cpp","function":"f","callee":"call","value_type":"binary32","value_bits":"0x3f000000","argument":{"argument_index":1,"value_type":"binary32","value_bits":"0x44000000"},"evaluate_first":false},
+            {"translation_unit":"test.cpp","function":"f","callee":"call","value_type":"binary32","value_bits":"0x3f000000","evaluate_first":false}
+        ]}}"#;
+        let value: serde_json::Value = serde_json::from_str(value).unwrap();
+        serde_json::from_value(value["floating_point"]["expression_overrides"].clone()).unwrap()
+    }
+
+    #[test]
+    fn equal_specificity_conflicts_are_rejected_in_both_row_orders() {
+        let mut rows = policy_rows();
+        for _ in 0..2 {
+            assert!(winning_rows(&rows, &[0, 1, 2]).unwrap_err().to_string().contains("conflicting"));
+            rows.swap(0, 1);
+        }
+        rows[0].evaluate_before = Some(1);
+        rows[0].evaluate_first = false;
+        rows[1].evaluate_first = false;
+        assert!(winning_rows(&rows, &[0, 1]).is_err());
+    }
+
+    #[test]
+    fn only_winning_rows_are_consumed_and_validation_does_not_select() {
+        let mut rows = policy_rows();
+        rows[1].evaluate_first = true;
+        rows[2].expected_matches = Some(9);
+        assert_eq!(winning_rows(&rows, &[0, 1, 2]).unwrap(), [0, 1]);
+        assert_eq!(winning_rows(&rows, &[2, 1, 0]).unwrap(), [1, 0]);
+        assert!(winning_rows(&rows, &[]).unwrap().is_empty());
+    }
+
+    fn walk_arguments() -> Vec<WalkArgument> {
+        [10, 20, 30, 40].iter().map(|&node| WalkArgument {
+            node, category: 1, evaluated: false, evaluate_first: false,
+        }).collect()
+    }
+
+    #[test]
+    fn ordinary_walk_priority_preserves_slots_and_rejects_invalid_dependencies() {
+        let arguments = walk_arguments();
+        assert_eq!(evaluation_order(&arguments, &[(40, 1)]).unwrap(), [10, 40, 20, 30]);
+        assert!(evaluation_order(&arguments, &[(10, 0)]).is_err());
+        assert!(evaluation_order(&arguments, &[(10, 4)]).is_err());
+        assert!(evaluation_order(&arguments, &[(50, 1)]).is_err());
+        assert!(evaluation_order(&arguments, &[(10, 1), (20, 0)]).is_err());
+    }
+
+    #[test]
+    fn priority_rejects_early_or_nonordinary_arguments_on_either_side() {
+        for index in [1, 3] {
+            for (category, evaluated, early) in [(0, false, false), (4, false, false),
+                (5, false, false), (1, true, false), (2, false, true)] {
+                let mut arguments = walk_arguments();
+                arguments[index].category = category;
+                arguments[index].evaluated = evaluated;
+                arguments[index].evaluate_first = early;
+                assert!(evaluation_order(&arguments, &[(40, 1)]).unwrap_err()
+                    .to_string().contains("does not participate"));
+            }
+        }
+        let mut arguments = walk_arguments();
+        arguments[1].category = 0x12;
+        assert!(evaluation_order(&arguments, &[(40, 1)]).is_ok());
+    }
+}
