+// Locate arguments of a sibling call expression by its compiler AST identity,
+// never by its occurrence or generated instruction address.
+fn nested_call_arguments(
+    process: &SBProcess,
+    compiler: &Compiler,
+    outer_arguments: u64,
+    callee: &str,
+) -> Result<Vec<u64>> {
+    let mut outer = outer_arguments;
+    let mut visited = HashSet::new();
+    let mut arguments = Vec::new();
+    while outer != 0 {
+        ensure!(visited.insert(outer), "cyclic outer argument list");
+        ensure!(
+            visited.len() <= 16,
+            "outer argument list exceeds verified limit"
+        );
+        let expression = u32_at(process, outer + 4)? as u64;
+        if expression != 0 && read(process, expression, 1)?[0] == 0x36 {
+            let target = u32_at(process, expression + compiler.node_value)? as u64;
+            if call_target(process, compiler, target)?.as_deref() == Some(callee) {
+                arguments.push(u32_at(process, expression + compiler.node_value + 4)? as u64);
+            }
+        }
+        outer = u32_at(process, outer)? as u64;
+    }
+    Ok(arguments)
+}
+
+fn nested_argument(process: &SBProcess, mut list: u64, argument_index: u8) -> Result<Option<u64>> {
+    let mut visited = HashSet::new();
+    for index in 0..=argument_index {
+        if list == 0 {
+            return Ok(None);
+        }
+        ensure!(visited.insert(list), "cyclic nested argument list");
+        let argument = u32_at(process, list + 4)? as u64;
+        if index == argument_index {
+            return Ok(Some(argument));
+        }
+        list = u32_at(process, list)? as u64;
+    }
+    Ok(None)
+}
+
+fn nested_call_matches(
+    process: &SBProcess,
+    compiler: &Compiler,
+    state: &HookState,
+    function_object: u32,
+    outer_arguments: u64,
+    selector: &config::NestedCallSelector,
+) -> Result<bool> {
+    for list in nested_call_arguments(process, compiler, outer_arguments, &selector.callee)? {
+        if let Some(argument) = nested_argument(process, list, selector.argument_index)? {
+            if argument_constant(process, compiler, state, function_object, argument)?
+                == Some((selector.value_type, selector.value_bits))
+            {
+                return Ok(true);
+            }
+        }
+    }
+    Ok(false)
+}
+
+fn nested_variable_matches(
+    process: &SBProcess,
+    compiler: &Compiler,
+    state: &HookState,
+    outer_arguments: u64,
+    selector: &config::NestedVariableSelector,
+) -> Result<bool> {
+    for list in nested_call_arguments(process, compiler, outer_arguments, &selector.callee)? {
+        let Some(argument) = nested_argument(process, list, selector.argument_index)? else {
+            continue;
+        };
+        if read(process, argument, 1)?[0] != 4 {
+            continue;
+        }
+        let reference = u32_at(process, argument + compiler.node_value)? as u64;
+        if reference == 0 || read(process, reference, 1)?[0] != 0x38 {
+            continue;
+        }
+        let object = u32_at(process, reference + compiler.node_value)?;
+        if object != 0 && !state.literal_objects.contains(&object) {
+            return Ok(true);
+        }
+    }
+    Ok(false)
+}
