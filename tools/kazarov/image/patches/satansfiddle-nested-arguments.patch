+#[test]
+fn nested_call_selector_is_semantic_and_validated() {
+    let nested = format!(
+        "{EXPRESSION}\n[floating_point.expression_overrides.nested_call]\ncallee = 'unitRotation__FP8mgCFrameff'\nargument_index = 2\nvalue_type = 'binary32'\nvalue_bits = '0x41800000'\n"
+    );
+    assert!(
+        parse(&nested).is_err(),
+        "nested selector requires outer callee"
+    );
+    let scoped = EXPRESSION.replace(
+        "function = 'float__Fv'",
+        "function = 'float__Fv'\ncallee = 'SetRotation__9mgCObjectFfff'",
+    );
+    let valid = nested.replacen(EXPRESSION, &scoped, 1);
+    let config = parse(&valid).unwrap();
+    let selector = config.floating_point.expression_overrides[0]
+        .nested_call
+        .as_ref()
+        .unwrap();
+    assert_eq!(selector.argument_index, 2);
+    assert_eq!(selector.value_bits, 0x41800000);
+    assert!(parse(&valid.replace("argument_index = 2", "argument_index = 16")).is_err());
+    assert!(parse(&format!("{valid}\n{valid}")).is_err());
+
+    let variable = format!(
+        "{scoped}\n[floating_point.expression_overrides.nested_variable]\ncallee = 'unitRotation__FP8mgCFrameff'\nargument_index = 1\n"
+    );
+    let config = parse(&variable).unwrap();
+    assert_eq!(
+        config.floating_point.expression_overrides[0]
+            .nested_variable
+            .as_ref()
+            .unwrap()
+            .argument_index,
+        1
+    );
+    assert!(parse(&variable.replace("argument_index = 1", "argument_index = 16")).is_err());
+}
